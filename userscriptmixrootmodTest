(function () {
    'use strict';

    // Ensure the script runs after the page has fully loaded
    window.addEventListener('load', function () {
        console.log("Page loaded. Starting AdBlock bypass script...");

        // Locate the hidden input field
        const inputField = document.querySelector('input[name="newwpsafelink"]');
        if (inputField && inputField.value) {
            console.log("Found hidden input field:", inputField);

            try {
                // Step 1: Decode the first Base64-encoded value
                const firstDecodedValue = atob(inputField.value);
                console.log("First Base64 decoded value:", firstDecodedValue);

                // Step 2: Parse the JSON object
                const jsonData = JSON.parse(firstDecodedValue);
                console.log("Parsed JSON data:", jsonData);

                // Step 3: Extract the `linkr` field
                if (jsonData.linkr) {
                    console.log("Found 'linkr' field:", jsonData.linkr);

                    // Extract the `safelink_redirect` parameter from the URL
                    const safelinkMatch = jsonData.linkr.match(/safelink_redirect=([^&]+)/);
                    if (safelinkMatch && safelinkMatch[1]) {
                        const safelinkRedirect = safelinkMatch[1];
                        console.log("Second Base64 encoded value found:", safelinkRedirect);

                        // Step 4: Decode the second Base64-encoded value
                        const secondDecodedValue = atob(safelinkRedirect);
                        console.log("Second Base64 decoded value:", secondDecodedValue);

                        // Step 5: Parse the final JSON data
                        const finalData = JSON.parse(secondDecodedValue);
                        console.log("Final parsed JSON data:", finalData);

                        // Step 6: Extract and decode the final URL
                        let finalUrl = null;
                        if (finalData.safelinks) {
                            finalUrl = finalData.safelinks;
                        } else if (finalData.safelink) {
                            finalUrl = finalData.safelink;
                        } else if (finalData.safelink_redirect_url) {
                            finalUrl = finalData.safelink_redirect_url;
                        }

                        if (finalUrl) {
                            // Decode the URL if it is URL-encoded
                            finalUrl = decodeURIComponent(finalUrl);
                            console.log("Redirecting to final URL:", finalUrl);
                            window.location.href = finalUrl;
                        } else {
                            console.log("No valid redirect URL found in the final JSON data.");
                        }
                    } else {
                        console.log("No valid 'safelink_redirect' parameter found in the 'linkr' URL.");
                    }
                } else {
                    console.log("No 'linkr' field found in the JSON data.");
                }
            } catch (error) {
                console.error("Error during AdBlock bypass script execution:", error);
            }
        } else {
            console.log("Hidden input field not found or no value present.");
        }
    });
})();
